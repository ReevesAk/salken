# Copy to .env and fill in. Every value is optional for local development.
# In production set DEBUG=False; SECRET_KEY is then required.
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Set to True once the site is served over HTTPS: enables the HTTPS redirect,
# secure cookies, and HSTS (SECURE_HSTS_SECONDS, default 3600).
HTTPS=False

# PostgreSQL (Amazon RDS). Leave RDS_DB_NAME empty to use SQLite. To use the
# Compose database from a local runserver, run 'docker compose up -d db' and
# set RDS_DB_NAME=salken; the other values below already match it.
RDS_DB_NAME=
RDS_USERNAME=salken
RDS_PASSWORD=salken
RDS_HOSTNAME=localhost
RDS_PORT=5432

# S3 static files. When AWS_STORAGE_BUCKET_NAME is unset, files are served locally.
# AWS_STORAGE_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Log verbosity: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
# 'text' or 'json'. Defaults to text when DEBUG=True, JSON otherwise.
# LOG_FORMAT=text

# Error tracking. Unhandled exceptions go to Sentry only when SENTRY_DSN is set.
SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.0
