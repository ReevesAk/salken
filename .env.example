# Copy to .env and fill in. Every value is optional for local development.
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (Amazon RDS). When RDS_DB_NAME is unset, SQLite is used.
# RDS_DB_NAME=salken
# RDS_USERNAME=postgres
# RDS_PASSWORD=change-me
# RDS_HOSTNAME=localhost
# RDS_PORT=5432

# S3 static files. When AWS_STORAGE_BUCKET_NAME is unset, files are served locally.
# AWS_STORAGE_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Log verbosity: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
